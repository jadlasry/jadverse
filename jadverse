<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,800&family=DM+Sans:wght@500;700&display=swap');
:root{--y:#ffd800;--pk:#ff2e7e;--cw:84px}
*{box-sizing:border-box;margin:0;padding:0;user-select:none;font-family:'DM Sans',sans-serif;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;color:#fff;background:#12062b}
body{background:radial-gradient(circle at 50% 38%,#4a1d96 0,#1b0a40 45%,#0b0320 100%)}
body::before{content:"";position:fixed;inset:-50%;background:repeating-conic-gradient(rgba(255,255,255,.035) 0 10deg,transparent 0 20deg);animation:rot 90s linear infinite;pointer-events:none}
@keyframes rot{to{transform:rotate(360deg)}}
#fx{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:300}
.hidden{display:none!important}
button{cursor:pointer;border:none;font-family:Fraunces;color:#111}
/* LOBBY */
#lobby{position:relative;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:16px;overflow:auto}
.logo{display:flex;gap:6px;margin-bottom:2px}
.logo span{font:clamp(3rem,13vw,6.5rem)/1 Fraunces;width:1.05em;height:1.45em;display:grid;place-items:center;border:5px solid #fff;border-radius:14px;box-shadow:0 8px 0 rgba(0,0,0,.4);animation:bob 2.4s ease-in-out infinite}
.logo span:nth-child(1){background:#e53935;transform:rotate(-9deg)}.logo span:nth-child(2){background:#ffc400;animation-delay:.2s;transform:rotate(4deg)}
.logo span:nth-child(3){background:#1e6bff;animation-delay:.4s;transform:rotate(-3deg)}.logo span:nth-child(4){background:#1fa855;animation-delay:.6s;transform:rotate(8deg)}
@keyframes bob{50%{translate:0 -12px}}
.tag{font:.8rem Fraunces;letter-spacing:3px;color:var(--y)}
.menu{width:min(480px,100%);background:rgba(10,3,30,.7);border:3px solid #fff;border-radius:24px;padding:18px;display:flex;flex-direction:column;gap:12px;box-shadow:8px 8px 0 var(--pk)}
.in{width:100%;padding:12px;border-radius:12px;border:3px solid #fff;background:#12062b;color:#fff;font:800 1.1rem 'DM Sans';text-align:center;outline:none}
.in:focus{border-color:var(--y)}
.lab{font:.7rem Fraunces;color:#b9a6ee}
.row{display:flex;gap:8px}.row>*{flex:1}
.pill{padding:10px 4px;border-radius:12px;background:#2a1260;color:#fff;font-size:.72rem;border:3px solid transparent}
.pill.on{background:var(--y);color:#111;border-color:#fff;transform:translateY(-3px);box-shadow:0 4px 0 #000}
.chk{display:flex;gap:8px;align-items:center;font-weight:800;font-size:.95rem}.chk input{width:20px;height:20px;accent-color:var(--pk)}
.big{padding:16px;border-radius:16px;background:var(--pk);color:#fff;font-size:1.05rem;border:3px solid #fff;box-shadow:0 6px 0 #000;transition:.1s}
.big:active{transform:translateY(5px);box-shadow:0 1px 0 #000}
.sm{padding:12px;border-radius:12px;background:#00e5ff;font-size:.7rem;border:3px solid #fff;box-shadow:0 4px 0 #000}
.sm.g{background:#3ddc84}.sm.w{background:#fff}
/* JEU */
#game{position:relative;z-index:5;height:100%;display:flex;flex-direction:column}
#game.shake{animation:sh .45s}@keyframes sh{20%{transform:translate(-9px,5px)}40%{transform:translate(8px,-6px)}60%{transform:translate(-6px,4px)}80%{transform:translate(4px,-2px)}}
.hud{display:flex;align-items:center;gap:10px;padding:10px 12px}
.badge{background:#000a;border:3px solid #fff;border-radius:14px;padding:4px 12px;font:.75rem Fraunces;cursor:pointer}
#turn{flex:1;text-align:center;font:.95rem Fraunces;padding:6px;border-radius:14px;background:#0008;border:3px solid #fff}
#turn.mine{background:var(--y);color:#111;animation:pu .7s infinite alternate}@keyframes pu{to{transform:scale(1.05)}}
.leave{background:#ff3b30;color:#fff;border:3px solid #fff;border-radius:14px;padding:6px 12px;font-size:.7rem}
.barw{height:8px;margin:0 12px;background:#0006;border-radius:6px;overflow:hidden}
#bar{height:100%;width:0;background:#3ddc84;transition:width .25s linear}#bar.low{background:#ff3b30}
#opps{display:flex;justify-content:center;gap:10px;padding:10px;flex-wrap:wrap}
.opp{position:relative;display:flex;flex-direction:column;align-items:center;padding:8px 14px 10px;border-radius:18px;background:#ffffff14;border:3px solid transparent;min-width:110px}
.opp.active{border-color:var(--y);box-shadow:0 0 0 4px #ffd80040,0 0 34px #ffd800aa}
.av{font-size:2rem;line-height:1}.nm{font-weight:800;font-size:.9rem;white-space:nowrap}.nm small{color:var(--y);font-size:.65rem}
.fan{display:flex;margin:6px 0 0 12px;min-height:30px}
.mb{width:20px;height:30px;border-radius:5px;border:2px solid #fff;background:repeating-linear-gradient(45deg,#e53935 0 5px,#16121f 5px 10px);margin-left:-12px}
.cnt{position:absolute;top:-8px;right:-8px;background:var(--pk);border:3px solid #fff;border-radius:12px;font:.75rem Fraunces;padding:1px 7px}
.float{position:absolute;top:-6px;font-size:2.4rem;animation:up 1.8s forwards;pointer-events:none;z-index:9}@keyframes up{to{transform:translateY(-80px) scale(1.5);opacity:0}}
#mid{flex:1;display:flex;align-items:center;justify-content:center;gap:28px;position:relative;min-height:0}
#dir{position:absolute;width:min(330px,80vw);aspect-ratio:1;border:6px dashed #ffffff30;border-radius:50%;animation:rot 12s linear infinite}
#dir.rev{animation-direction:reverse}
.card{--c:#e53935;--t:#e53935;position:relative;width:var(--cw);height:calc(var(--cw)*1.45);border-radius:13px;border:4px solid #fff;background:var(--c);display:grid;place-items:center;box-shadow:0 6px 0 #0006;flex:none;cursor:pointer;font-family:Fraunces;transition:transform .2s,box-shadow .2s}
.card i{position:absolute;inset:12% 6%;background:#fff;border-radius:50%;transform:rotate(-26deg)}
.card b{position:relative;color:var(--t);font-size:calc(var(--cw)*.4);font-weight:400;text-shadow:2px 2px 0 #0003}
.card::before,.card::after{content:attr(data-v);position:absolute;font-size:calc(var(--cw)*.19);color:#fff;top:3px;left:6px;z-index:2}
.card::after{top:auto;left:auto;bottom:3px;right:6px;transform:rotate(180deg)}
.red{--c:#e53935;--t:#e53935}.blue{--c:#1e6bff;--t:#1e6bff}.green{--c:#1fa855;--t:#1fa855}.yellow{--c:#ffc400;--t:#d08c00}
.wild{background:conic-gradient(#e53935 0 25%,#1e6bff 0 50%,#1fa855 0 75%,#ffc400 0);--t:#111}
.back{background:#16121f}.back i{background:#e53935}.back b{color:var(--y);font-size:calc(var(--cw)*.28)}.back::before,.back::after{content:""}
#draw:hover{transform:translateY(-6px) rotate(-3deg)}
#pile{box-shadow:0 0 0 8px #ffffff22,0 0 70px 18px var(--c);rotate:var(--tilt,0deg)}
#pile.pop{animation:pop .45s cubic-bezier(.2,1.2,.4,1)}@keyframes pop{from{translate:0 var(--fy,160px);scale:1.4;rotate:35deg;opacity:.3}}
#tick{position:absolute;bottom:2px;left:50%;transform:translateX(-50%);font-weight:800;color:#d9ccff;background:#0007;padding:2px 14px;border-radius:12px;white-space:nowrap;max-width:94%;overflow:hidden;text-overflow:ellipsis;font-size:.9rem}
#bang{position:fixed;left:50%;top:42%;z-index:150;font:clamp(3rem,16vw,8rem) Fraunces;color:var(--y);-webkit-text-stroke:3px #000;text-shadow:6px 6px 0 var(--pk);pointer-events:none;opacity:0;translate:-50% -50%}
#bang.go{animation:bg 1s ease-out}@keyframes bg{0%{opacity:1;scale:.2;rotate:-15deg}30%{opacity:1;scale:1.2;rotate:6deg}80%{opacity:1;scale:1}100%{opacity:0;scale:1.5}}
#hand{height:calc(var(--cw)*1.45 + 70px);display:flex;justify-content:center;align-items:flex-end;padding:0 10px 12px;position:relative}
#hand .card{margin-left:var(--ml,-40px);transform:rotate(var(--r)) translateY(var(--y));transform-origin:50% 140%}
#hand .card.ok{--y:-22px;box-shadow:0 0 0 4px var(--y2,#ffd800),0 0 24px #ffd800}
#hand .card.no{filter:brightness(.5) saturate(.7)}
#hand .card:hover{transform:rotate(0) translateY(-44px) scale(1.15);z-index:20}
#me{position:absolute;left:12px;bottom:8px;display:flex;flex-direction:column;align-items:center;gap:2px;padding:4px 10px;border-radius:14px;z-index:30}
#react{position:absolute;left:12px;bottom:90px;display:flex;flex-direction:column;gap:2px;z-index:30}
#react span{font-size:1.4rem;cursor:pointer;transition:.15s}#react span:hover{transform:scale(1.5)}
#uno{position:absolute;right:14px;bottom:calc(var(--cw)*1.45 + 40px);z-index:40;padding:16px 22px;border-radius:50%;background:var(--pk);color:#fff;border:4px solid #fff;font-size:1rem;box-shadow:0 6px 0 #000;animation:pu .45s infinite alternate}
.ov{position:fixed;inset:0;z-index:100;background:#0b0320d0;display:flex;align-items:center;justify-content:center;padding:16px}
.box{background:#1b0a40;border:4px solid #fff;border-radius:26px;padding:22px;width:min(440px,100%);text-align:center;display:flex;flex-direction:column;gap:10px;box-shadow:10px 10px 0 var(--pk)}
.box h2{font:1.7rem Fraunces;color:var(--y)}.pl{display:flex;align-items:center;gap:8px;justify-content:center;font-weight:800;font-size:1.1rem}.pl small{color:var(--y)}
.pl button{background:#ff3b30;color:#fff;border-radius:8px;padding:2px 8px;font-size:.7rem}
#picker{display:grid;grid-template-columns:1fr 1fr;gap:12px;width:230px}#picker div{aspect-ratio:1;border-radius:18px;border:4px solid #fff;cursor:pointer;box-shadow:0 5px 0 #000}#picker div:hover{transform:scale(1.1) rotate(-4deg)}
#toast{position:fixed;top:60px;left:50%;transform:translateX(-50%);background:var(--pk);border:3px solid #fff;padding:6px 18px;border-radius:16px;font:.8rem Fraunces;z-index:400;opacity:0;pointer-events:none;transition:.25s}#toast.on{opacity:1}
.foot{position:fixed;left:50%;bottom:8px;translate:-50% 0;font:.7rem Fraunces;color:#fff;background:#0008;border:2px solid #fff6;border-radius:20px;padding:4px 16px;z-index:2;pointer-events:none;white-space:nowrap}.foot b{color:var(--y)}
.by{font:.8rem Fraunces;background:linear-gradient(90deg,var(--pk),var(--y));color:#111;padding:6px 18px;border-radius:20px;border:3px solid #fff;box-shadow:0 4px 0 #000;rotate:-2deg}
.hby{font:.6rem Fraunces;background:linear-gradient(90deg,var(--pk),var(--y));color:#111;padding:5px 10px;border-radius:12px;border:2px solid #fff;white-space:nowrap}
.menu,.logo,.tag,.by,.chips{position:relative;z-index:1}
.fl{position:fixed;width:70px;height:100px;border:4px solid #fff;border-radius:12px;opacity:.16;animation:fl 9s ease-in-out infinite;pointer-events:none}
@keyframes fl{50%{translate:0 -34px;rotate:14deg}}
.chips{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;max-width:480px}
.chips span{background:#ffffff18;border:2px solid #fff4;border-radius:20px;padding:1px 12px;font-weight:800;font-size:.8rem}
.hud{background:linear-gradient(#000a,#0000)}
#table{position:absolute;width:min(94%,680px);height:min(92%,380px);border-radius:50%;background:radial-gradient(ellipse,#5b2bc4 0,#34147d 55%,#1a0a47 100%);border:10px solid #2a1260;box-shadow:0 0 0 4px var(--y),inset 0 0 70px #000b,0 24px 60px #000a}
#table::after{content:"UNO";position:absolute;inset:0;display:grid;place-items:center;font:clamp(4rem,15vw,9rem) Fraunces;color:#ffffff12;rotate:-8deg}
.chip{position:absolute;top:10px;left:50%;translate:-50% 0;padding:3px 16px;border-radius:14px;border:3px solid #fff;font:.7rem Fraunces;background:var(--c);color:#fff;box-shadow:0 4px 0 #000;z-index:2}.chip.yellow{color:#111}
#draw{box-shadow:3px 3px 0 #2b2b2b,6px 6px 0 #fff,9px 9px 0 #2b2b2b,12px 12px 0 #0007}
#dk{position:absolute;bottom:-18px;left:50%;translate:-50% 0;background:#000c;border:2px solid #fff;border-radius:10px;font:.65rem Fraunces;padding:1px 8px;font-style:normal}
.opp{background:linear-gradient(160deg,#ffffff24,#ffffff08);backdrop-filter:blur(6px);box-shadow:0 8px 20px #0005}
.av{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle,#ffffff40,#ffffff08);border:3px solid #fff}
@keyframes gl{to{box-shadow:0 0 0 4px #ffd800,0 0 40px 6px #ffd800}}
#hand .card.ok{animation:gl .8s infinite alternate}
@media(max-width:420px){.hby{display:none}}
#gear{position:fixed;top:10px;right:10px;z-index:250;width:44px;height:44px;border-radius:50%;background:#fff;border:3px solid #000;font-size:1.3rem;box-shadow:0 4px 0 #000}
.hud{padding-right:64px}
input[type=range]{width:100%;accent-color:var(--pk);height:28px}
button{transition:transform .12s,box-shadow .12s,filter .2s}button:hover{filter:brightness(1.12)}
.ov{animation:fo .25s}@keyframes fo{from{opacity:0}}
.box{animation:pi .4s cubic-bezier(.2,1.4,.4,1)}@keyframes pi{from{scale:.8;opacity:0}}
#game{animation:gin .5s}@keyframes gin{from{opacity:0;scale:.97}}
.opp{transition:border-color .3s,box-shadow .3s}
#hand .card{transition:transform .3s cubic-bezier(.2,1.3,.4,1),box-shadow .25s,filter .3s}
html:not([data-theme=neon]){background:var(--bg);color-scheme:light;
